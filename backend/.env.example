DATABASE_URL=postgresql://user:password@host:5432/database
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
ADMIN_KEY=your-admin-secret-key-here
FRONTEND_ORIGIN=http://localhost:5500

# Optional WebRTC TURN server configuration for cross-network voice chat (NAT/firewall traversal).
# Voice chat works same-network without TURN (via Google STUN), but cross-network calls over
# symmetric NATs, cellular data, or corporate/campus firewalls require TURN credentials.
TURN_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password

